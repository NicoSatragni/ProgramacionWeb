package views

import (
	"fmt"
	"progweb/db/sqlc"
)

templ EntityList(items []db.ShoppingItem) {
	<section class="saas-card" aria-labelledby="list-heading">
		<div class="card-header">
			<h2 id="list-heading" class="card-title">Artículos pendientes</h2>
			<span class="pill-counter">
				{ fmt.Sprintf("%d %s", len(items), pluralizeItems(len(items))) }
			</span>
		</div>
		if len(items) == 0 {
			<div class="empty-state-card">
				<h3 class="empty-title">No hay artículos en la lista</h3>
				<p class="empty-description">Los productos que agregues arriba quedarán guardados para las compras de la casa.</p>
			</div>
		} else {
			<div class="saas-table-container">
				<table class="saas-table">
					<thead>
						<tr>
							<th scope="col">Artículo</th>
							<th scope="col" style="width: 140px;">Cantidad</th>
							<th scope="col" style="width: 120px; text-align: right;">Acción</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range items {
							<tr>
								<td>
									<span class="item-name">{ item.Title }</span>
								</td>
								<td>
									<span class="tabular-number">{ fmt.Sprintf("x%d", item.Quantity) }</span>
								</td>
								<td style="text-align: right;">
									<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/shopping-items/%d/delete", item.ID)) } style="margin: 0; display: inline;">
										<button
											type="submit"
											class="btn-delete-ghost"
											aria-label={ fmt.Sprintf("Eliminar %s", item.Title) }
										>
											Eliminar
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

func pluralizeItems(count int) string {
	if count == 1 {
		return "artículo"
	}
	return "artículos"
}
